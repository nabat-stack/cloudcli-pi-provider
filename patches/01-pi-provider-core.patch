+test('selectActivePiBranch keeps only the branch pi is currently on', () => {
+  // A retried turn leaves both attempts in the file as children of the same
+  // parent: the failed one first, the retry second. Reading file order would
+  // replay both, so history must follow the leaf's parent chain instead.
+  const entries = [
+    { type: 'message', id: 'u1', parentId: null, message: { role: 'user', content: 'hi' } },
+    { type: 'message', id: 'a1', parentId: 'u1', message: { role: 'assistant', content: [], stopReason: 'error' } },
+    { type: 'message', id: 'a2', parentId: 'u1', message: { role: 'assistant', content: [{ type: 'text', text: 'ok' }] } },
+  ];
+
+  const selected = selectActivePiBranch(entries);
+
+  assert.deepEqual(selected.map((entry) => entry.id), ['u1', 'a2']);
+});
