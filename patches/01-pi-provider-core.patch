+    { type: 'message', id: 'a1', parentId: 'u1', message: { role: 'assistant', content: [{ type: 'text', text: 'first' }] } },
+    { type: 'message', id: 'u2', parentId: 'a1', message: { role: 'user', content: 'two' } },
+    // Abandoned attempt on the second turn, then the retry.
+    { type: 'message', id: 'a2abandoned', parentId: 'u2', message: { role: 'assistant', content: [], stopReason: 'error' } },
+    { type: 'message', id: 'a2', parentId: 'u2', message: { role: 'assistant', content: [{ type: 'text', text: 'second' }] } },
