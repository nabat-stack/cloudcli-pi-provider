+test('a finishing run releases only the process-table entries it still owns', () => {
+  // Stop then immediately send again: the aborted child's `close` arrives after
+  // a replacement run is already registered under the same session key.
+  // Deleting by key alone would evict that replacement, leaving its pi process
+  // unstoppable by `abort`. releasePiProcess is the invariant that prevents it.
+  const first = { aborted: false } as PiProcessHandle;
+  const second = { aborted: false } as PiProcessHandle;
+
+  activePiProcessesForTest.set('app', first);
+  activePiProcessesForTest.set('native-1', first);
+
+  // The replacement takes over both keys before the old child closes.
+  activePiProcessesForTest.set('app', second);
+  activePiProcessesForTest.set('native-1', second);
+
+  releasePiProcessForTest('app', first);
+  releasePiProcessForTest('native-1', first);
+
+  assert.equal(activePiProcessesForTest.get('app'), second, 'the replacement must survive the old close');
+  assert.equal(activePiProcessesForTest.get('native-1'), second);
+
+  // The replacement's own close does clear them.
+  releasePiProcessForTest('app', second);
+  assert.equal(activePiProcessesForTest.has('app'), false);
+});
