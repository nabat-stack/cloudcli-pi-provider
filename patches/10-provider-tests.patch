+      api: 'anthropic-messages',
+      provider: 'anthropic',
+      model: 'glm-5.3',
+      stopReason: 'stop',
+      usage: { input: 10, output: 0, cacheRead: 0, cacheWrite: 0, totalTokens: 10 },
+    },
