+  for (const key of ['ANTHROPIC_API_KEY', 'OPENAI_API_KEY', 'ZAI_CODING_CN_API_KEY']) {
+    assert.ok(PI_ENV_CREDENTIAL_KEYS.includes(key), `${key} is missing from the manifest`);
+  }
