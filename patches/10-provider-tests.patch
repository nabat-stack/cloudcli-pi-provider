+const sessionHeaderLine = (sessionId: string, timestamp: string, cwd: string) =>
+  JSON.stringify({ type: 'session', version: 3, id: sessionId, timestamp, cwd });
+
+const userMessageLine = (text: string) =>
+  JSON.stringify({
+    type: 'message',
+    id: 'm-user',
+    parentId: null,
+    timestamp: '2026-09-12T13:52:06.000Z',
+    message: {
