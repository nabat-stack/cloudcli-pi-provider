+// ---------------------------
+//----------------- PI SESSION STORAGE UTILITIES ------------
+/**
+ * Resolves pi's agent directory: its settings, models, skills and sessions root.
+ *
+ * pi honours `PI_CODING_AGENT_DIR`, and everything pi itself reads — the model
+ * catalog, the credential store, the session tree — follows it. Resolving the
+ * default here instead would make CloudCLI read a directory pi is not using, so
+ * share this single resolver rather than joining the path at each call site.
+ */
+export function getPiAgentDir(): string {
+  const configured = process.env.PI_CODING_AGENT_DIR?.trim();
+  return configured || path.join(os.homedir(), '.pi', 'agent');
+}
+
+/**
+ * Resolves the Pi session directory.
+ *
+ * Pi writes one JSONL transcript per session under `<agent dir>/sessions`
+ * (grouped per project directory). Watchers and synchronizers should treat this
+ * path as read-only input and never store it as the deletable transcript path
+ * of an individual app session row.
+ */
+export function getPiSessionDir(): string {
+  return path.join(getPiAgentDir(), 'sessions');
+}
