+type PiLogoProps = {
+  className?: string;
+};
+
+/**
+ * Rendered by the shared LLMProviderLogo when the provider is Pi.
+ *
+ * Pi's own mark: three interlocking squares in its brand palette, traced from
+ * the published logo at https://pi.dev/logo-auto.svg (viewBox 0 0 800 800).
+ * Unlike the single-colour sibling logos this one keeps Pi's three fills, the
+ * same way ClaudeLogo keeps its own brand colour, so the mark stays
+ * recognisable at the 16–24px sizes the provider lists use.
+ */
+const PiLogo = ({ className = 'w-5 h-5' }: PiLogoProps) => (
+  <svg
+    viewBox="0 0 800 800"
+    role="img"
+    aria-label="Pi"
+    className={className}
+    fill="none"
+    xmlns="http://www.w3.org/2000/svg"
+  >
+    <path fill="#F09082" d="M165.29 165.29H517.36V400H400V282.65H165.29Z" />
+    <path fill="#4D9ABF" d="M165.29 282.65H282.65V400H400V517.36H282.65V634.72H165.29Z" />
+    <path fill="#F1BE58" d="M517.36 400H634.72V634.72H517.36Z" />
+  </svg>
+);
+
+export default PiLogo;
